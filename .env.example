# --- App ---
APP_URL=http://localhost:3000
# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Vercel Cron sends this as a Bearer token. Generate like SESSION_SECRET.
CRON_SECRET=

# --- Database: Supabase Postgres, Canada (Central) region ---
# Use the "transaction pooler" connection string from Supabase → Project settings → Database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reading_routine

# --- Claude through Amazon Bedrock, Canada (Central) ---
# "mock" writes placeholder stories so the app runs without AWS. Use "bedrock" in production.
STORY_ENGINE=mock
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock model IDs. Check which Claude models your AWS account can use in ca-central-1.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8

# --- Email: Amazon SES, ca-central-1 (uses the AWS keys above) ---
# "outbox" saves emails to ./.outbox instead of sending. Use "ses" in production.
EMAIL_TRANSPORT=outbox
EMAIL_FROM=The Reading Routine <hello@thereadingroutine.ca>

# --- Stripe (leave blank to skip payments in development) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create these with: npm run stripe:setup
STRIPE_PRICE_FIRST_CHILD=
STRIPE_PRICE_SIBLING=
TRIAL_DAYS=14
